CEREBRAS_API_KEY=your_cerebras_key_here
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY_FREE=your_gemini_free_tier_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_key_here

# Telegram bot (optional). Set to enable long-polling in the FastAPI lifespan.
# TELEGRAM_BOT_TOKEN=
# Restrict to your numeric user ID(s) so strangers cannot burn API keys (comma-separated).
# TELEGRAM_ALLOWED_USER_IDS=123456789

QDRANT_HOST=localhost
QDRANT_PORT=6333
# Mem0: Gemini embeddings + Gemma LLM for extraction (optional overrides)
# MEM0_QDRANT_COLLECTION=agent_memories_gemini
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# GEMINI_EMBEDDING_DIMS=768
# MEM0_LLM_MODEL=gemma-4-26b-a4b-it

# Shell execution tool (tools/shell.py)
# AGENT_WORKSPACE=/path/to/workspace   # default: <project-root>/workspace
# AGENT_SHELL_TIMEOUT=30               # seconds per command (default 30)

# Agent loop: allow multi-tool assistant messages (OpenAI parallel_tool_calls) and
# run read-only tool batches concurrently. Set false if your provider rejects the flag.
# AGENT_PARALLEL_TOOL_CALLS=true

# Pyright LSP navigation tools (lsp_*): JSON argv for the language server process.
# Default: ["npx","-y","--package=pyright","pyright-langserver","--stdio"]
# (the pyright-langserver binary lives inside the npm "pyright" package, not its own package).
# LSP_PYRIGHT_COMMAND=["npx","-y","--package=pyright","pyright-langserver","--stdio"]
