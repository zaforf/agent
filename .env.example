CEREBRAS_API_KEY=your_cerebras_key_here
GROQ_API_KEY=your_groq_key_here
# Tier-1 — agent loop (Gemini providers in `agent._clients`). Sees full user + tool context.
GEMINI_API_KEY=your_gemini_key_here
# Optional — free-tier / summarizer-only key for Gemma 26B (`summarizer.summarize_gemma`):
# fetch_url prompt mode and history compaction. Alias: GEMINI_API_KEY_FREE
# If unset, summarizer calls fall back to GEMINI_API_KEY (warning logged).
GEMINI_SUMMARIZER_API_KEY=your_gemini_free_tier_key_here

# Optional — Qdrant host / port for long-term memory. Defaults to
# localhost:6333 for local dev; set to "qdrant" in prod docker-compose.
QDRANT_HOST=localhost
QDRANT_PORT=6333
